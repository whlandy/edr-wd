{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edr-wd.local/schemas/desktop-recording.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/recordingV1"
    },
    {
      "$ref": "#/$defs/recordingV2"
    }
  ],
  "$defs": {
    "recordingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sessionId",
        "name",
        "captureDiagnostics",
        "events"
      ],
      "properties": {
        "schema": {
          "const": "edr.desktop-recording/v1"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "captureDiagnostics": {
          "$ref": "#/$defs/captureDiagnostics"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "windows": {
          "type": "array",
          "description": "The application's windows as this capture saw them, in first-appearance order. `openedBy` carries the causal id of the action that opened the window, so the list reconstructs a tree of how the flow moved between pages.",
          "items": {
            "$ref": "#/$defs/windowEntryV1"
          }
        },
        "controlSnapshots": {
          "$ref": "#/$defs/controlSnapshots"
        },
        "rejections": {
          "$ref": "#/$defs/rejections"
        }
      }
    },
    "recordingV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sessionId",
        "name",
        "captureDiagnostics",
        "events"
      ],
      "properties": {
        "schema": {
          "const": "edr.desktop-recording/v2"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "captureDiagnostics": {
          "$ref": "#/$defs/captureDiagnostics"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "windows": {
          "type": "array",
          "description": "v2 adds `instanceId`: the recorded-window instance the entry names, matching the windowTimeline references.",
          "items": {
            "$ref": "#/$defs/windowEntryV2"
          }
        },
        "controlSnapshots": {
          "$ref": "#/$defs/controlSnapshots"
        },
        "rejections": {
          "$ref": "#/$defs/rejections"
        },
        "windowTimeline": {
          "$ref": "#/$defs/windowTimeline"
        }
      }
    },
    "captureDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "droppedPackets",
        "correlationErrorCount"
      ],
      "properties": {
        "droppedPackets": {
          "type": "integer",
          "minimum": 0
        },
        "correlationErrorCount": {
          "type": "integer",
          "minimum": 0
        },
        "outOfScopeEvents": {
          "type": "integer",
          "minimum": 0
        },
        "recorderUiEvents": {
          "type": "integer",
          "minimum": 0,
          "description": "Input events that landed on the recorder's own always-on-top UI instead of the target window. These never reached the target application and are deliberately not recorded as steps."
        },
        "unidentifiedTargetEvents": {
          "type": "integer",
          "minimum": 0,
          "description": "Clicks that landed on no control the application can name. They are not recorded as steps — replaying one would click a coordinate and hit whatever happened to be there — but they are counted so a recording never looks shorter than it was without saying why."
        }
      }
    },
    "windowEntryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "processName",
        "origin"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "processName": {
          "type": "string"
        },
        "handle": {
          "type": "integer"
        },
        "pid": {
          "type": "integer"
        },
        "origin": {
          "enum": [
            "already_open",
            "opened",
            "observed_during_flow"
          ]
        },
        "closed": {
          "type": "boolean"
        },
        "openedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reopenedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "windowEntryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "processName",
        "origin"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "processName": {
          "type": "string"
        },
        "handle": {
          "type": "integer"
        },
        "pid": {
          "type": "integer"
        },
        "origin": {
          "enum": [
            "already_open",
            "opened",
            "observed_during_flow"
          ]
        },
        "closed": {
          "type": "boolean"
        },
        "openedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reopenedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "windowTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "events",
        "coverage"
      ],
      "properties": {
        "schema": {
          "const": "edr.recorded-window-timeline/v1"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "order",
              "monotonicMs",
              "kind",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "monotonicMs": {
                "type": "integer"
              },
              "instanceId": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "initial_observed",
                  "created",
                  "shown",
                  "hidden",
                  "destroyed",
                  "identity_changed",
                  "lost",
                  "observed"
                ]
              },
              "source": {
                "enum": [
                  "initial_inventory",
                  "native_show",
                  "native_hide",
                  "native_destroy",
                  "native_identity_change",
                  "poller",
                  "tracking_loss",
                  "coverage",
                  "input_observation"
                ]
              },
              "associatedActionCausalId": {
                "type": "string"
              },
              "association": {
                "enum": [
                  "temporal_forward",
                  "temporal_backfill",
                  "unknown"
                ],
                "description": "The SOURCE of the link, never a confidence. 'explicit' is reserved for user-confirmed binding assertions and is invalid in recorded data."
              },
              "ingressSequence": {
                "type": "integer",
                "minimum": 1,
                "description": "The correlation receive sequence the packet arrived under, tying window facts and business events to one ingress order."
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "destroyEvents",
            "droppedEvents"
          ],
          "properties": {
            "destroyEvents": {
              "enum": [
                "supported",
                "unsupported",
                "unknown"
              ]
            },
            "droppedEvents": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "controlSnapshots": {
      "type": "array",
      "description": "Complete control trees for the windows the flow visited, in capture order and deduplicated by content. Events name only the control the user acted on; a generated trace can refer only to controls the recording knows exist, so the whole page is captured alongside.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshotId",
          "capturedAtMs",
          "window",
          "contentHash",
          "controls"
        ],
        "properties": {
          "snapshotId": {
            "type": "string",
            "minLength": 1
          },
          "capturedAtMs": {
            "type": "integer"
          },
          "reason": {
            "enum": [
              "window_changed",
              "step"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "contentHash": {
            "type": "string",
            "minLength": 1
          },
          "controlCount": {
            "type": "integer",
            "minimum": 0
          },
          "stateHash": {
            "type": "string",
            "minLength": 1
          },
          "truncated": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          },
          "window": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "handle": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "processName": {
                "type": "string"
              },
              "rootAutomationId": {
                "type": "string"
              }
            }
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "automationId": {
                  "type": "string"
                },
                "controlType": {
                  "type": "string"
                },
                "className": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "controlId": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "visible": {
                  "type": "boolean"
                },
                "protected": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "depth": {
                  "type": "integer",
                  "minimum": 0
                },
                "ancestry": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "rejections": {
      "type": "array",
      "description": "Input this capture saw and refused, with the window it resolved to. captureDiagnostics counts say a recording was short; only these say whether the recorder misjudged which window the user was in.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "point": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "resolvedProcess": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolvedTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolvedHandle": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "backend",
        "processName",
        "windowTitle"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "processName": {
          "type": "string",
          "minLength": 1
        },
        "windowTitle": {
          "type": "string"
        }
      }
    },
    "observedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "targetId",
        "fingerprint"
      ],
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "controlType": {
          "type": [
            "string",
            "null"
          ]
        },
        "automationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "rect": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer"
              }
            }
          ]
        },
        "ancestry": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "protected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sameNameSiblings": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "width",
        "height",
        "origin",
        "redacted",
        "redactions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CAP-[0-9a-f]{32}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer"
          }
        },
        "redacted": {
          "const": true
        },
        "redactions": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foregroundPid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "doubleClickIntervalMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "beforeCapture": {
          "$ref": "#/$defs/capture"
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "captureError": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "processName": {
              "type": "string"
            },
            "handle": {
              "type": "integer",
              "description": "Native window handle (HWND / CGWindowNumber). Identifies the window only within the live capture session that produced it — a fresh run of the application at replay time gets a different handle, so this is diagnostic evidence, never a replay selector field."
            }
          }
        },
        "handle": {
          "type": "integer"
        },
        "windowInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "windowTimelineEventId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "expected"
      ],
      "properties": {
        "type": {
          "enum": [
            "text_equals",
            "text_contains",
            "value_equals",
            "visible",
            "checked",
            "enabled",
            "window_open",
            "text_contains_time",
            "window_text_contains",
            "window_text_contains_time",
            "text_time_range",
            "window_text_time_range"
          ]
        },
        "expected": {},
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text_equals",
                  "text_contains",
                  "value_equals",
                  "text_time_range",
                  "window_text_time_range"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text_contains",
                  "window_text_contains"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "visible",
                  "checked",
                  "enabled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "window_open"
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "exists": {
                        "type": "boolean"
                      },
                      "processName": {
                        "type": "string"
                      },
                      "process_name": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "titleRegex": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "wallTime",
        "monotonicMs",
        "type",
        "scope"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "wallTime": {
          "type": "string",
          "minLength": 1
        },
        "monotonicMs": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "input": {
          "type": "object"
        },
        "observedTarget": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/observedTarget"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "causalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "assertion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/assertion"
            }
          ]
        }
      }
    }
  }
}