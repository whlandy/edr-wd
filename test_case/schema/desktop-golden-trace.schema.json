{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edr-wd.local/schemas/desktop-golden-trace.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/goldenV1"
    },
    {
      "$ref": "#/$defs/goldenV2"
    },
    {
      "$ref": "#/$defs/goldenV3"
    }
  ],
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processName": {
          "type": "string"
        },
        "titleRegex": {
          "type": "string"
        },
        "bundleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootAutomationId": {
          "type": "string",
          "description": "Stable UIA root identity of the window (design 09 §3)."
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automationId": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "controlType": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "ancestry": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "anchor": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "elementSha256",
        "redacted"
      ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "contextTemplate": {
          "type": "string",
          "minLength": 1
        },
        "elementSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contextSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contextOffset": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "relativePoint": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "redacted": {
          "const": true
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window",
        "control",
        "visual"
      ],
      "properties": {
        "window": {
          "$ref": "#/$defs/window"
        },
        "control": {
          "$ref": "#/$defs/control"
        },
        "visual": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/visual"
            }
          ]
        }
      }
    },
    "windowExpected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "processName": {
          "type": "string"
        },
        "process_name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "titleRegex": {
          "type": "string"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "expected"
      ],
      "properties": {
        "type": {
          "enum": [
            "text_equals",
            "text_contains",
            "value_equals",
            "visible",
            "checked",
            "enabled",
            "window_open",
            "text_contains_time",
            "window_text_contains",
            "window_text_contains_time",
            "text_time_range",
            "window_text_time_range"
          ]
        },
        "expected": {},
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "match": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "automation_id": {
              "type": "string",
              "minLength": 1
            },
            "identifier": {
              "type": "string",
              "minLength": 1
            },
            "control_type": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "automation_id"
              ]
            },
            {
              "required": [
                "identifier"
              ]
            },
            {
              "required": [
                "control_type",
                "text"
              ]
            }
          ]
        },
        "source": {
          "enum": [
            "user_assertion",
            "native_transition"
          ],
          "description": "Design 09 §5: strong effects come only from user-asserted window_open verifiers; a bare native transition is temporal evidence and never upgraded."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text_equals",
                  "text_contains",
                  "value_equals",
                  "text_time_range",
                  "window_text_time_range"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text_contains",
                  "window_text_contains"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "visible",
                  "checked",
                  "enabled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "window_open"
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/$defs/windowExpected"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "actionId",
        "args",
        "selector",
        "endSelector",
        "verifiers",
        "required",
        "status",
        "issues"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1
        },
        "actionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": "object"
        },
        "selector": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/selector"
            }
          ]
        },
        "endSelector": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/selector"
            }
          ]
        },
        "verifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verifier"
          }
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "incomplete"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "graphStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "actionId",
        "args",
        "selector",
        "endSelector",
        "verifiers",
        "required",
        "status",
        "issues",
        "next"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1
        },
        "actionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": "object"
        },
        "selector": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/selector"
            }
          ]
        },
        "endSelector": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/selector"
            }
          ]
        },
        "verifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verifier"
          }
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "incomplete"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "goldenV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "name",
        "sourceRecording",
        "catalog",
        "environment",
        "entry",
        "steps",
        "cleanup"
      ],
      "properties": {
        "schema": {
          "const": "edr.desktop-golden-trace/v1"
        },
        "status": {
          "enum": [
            "ready",
            "incomplete"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sourceRecording": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sha256"
          ],
          "properties": {
            "schema": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "digest"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string"
            },
            "backend": {
              "type": "string"
            },
            "application": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          }
        },
        "entry": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/graphStep"
          }
        },
        "cleanup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "goldenV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "name",
        "sourceRecording",
        "catalog",
        "environment",
        "entry",
        "steps",
        "cleanup"
      ],
      "properties": {
        "schema": {
          "const": "edr.desktop-golden-trace/v2"
        },
        "status": {
          "enum": [
            "ready",
            "incomplete"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sourceRecording": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sha256"
          ],
          "properties": {
            "schema": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "digest"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string"
            },
            "backend": {
              "type": "string"
            },
            "application": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          }
        },
        "entry": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/graphStep"
          }
        },
        "cleanup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "entryWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "processName",
            "origin"
          ],
          "properties": {
            "schema": {
              "const": "edr.entry-window-identity/v1"
            },
            "processName": {
              "type": "string",
              "minLength": 1
            },
            "titleRegex": {
              "type": "string",
              "minLength": 1
            },
            "rootAutomationId": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "enum": [
                "already_open",
                "opened"
              ]
            }
          }
        }
      }
    },
    "goldenV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "name",
        "sourceRecording",
        "catalog",
        "environment",
        "entry",
        "steps",
        "cleanup"
      ],
      "properties": {
        "schema": {
          "const": "edr.desktop-golden-trace/v3"
        },
        "status": {
          "enum": [
            "ready",
            "incomplete"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sourceRecording": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sha256"
          ],
          "properties": {
            "schema": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "digest"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string"
            },
            "backend": {
              "type": "string"
            },
            "application": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          }
        },
        "entry": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/graphStep"
          }
        },
        "cleanup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "entryWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "processName",
            "origin"
          ],
          "properties": {
            "schema": {
              "const": "edr.entry-window-identity/v1"
            },
            "processName": {
              "type": "string",
              "minLength": 1
            },
            "titleRegex": {
              "type": "string",
              "minLength": 1
            },
            "rootAutomationId": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "enum": [
                "already_open",
                "opened"
              ]
            }
          }
        },
        "windowSequence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "windows",
            "steps",
            "cleanup"
          ],
          "properties": {
            "schema": {
              "const": "edr.window-sequence/v1"
            },
            "windows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "identity",
                  "origin"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "origin": {
                    "enum": [
                      "already_open",
                      "observed_during_flow"
                    ]
                  },
                  "identity": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "processName"
                    ],
                    "properties": {
                      "processName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "titleRegex": {
                        "type": "string",
                        "minLength": 1
                      },
                      "rootAutomationId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stepId",
                  "windowId"
                ],
                "properties": {
                  "stepId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "windowId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "effects": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "kind",
                        "windowId",
                        "verification"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "appeared",
                            "absent"
                          ]
                        },
                        "windowId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "verification": {
                          "const": "explicit_assertion"
                        },
                        "timeoutSeconds": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 300
                        }
                      }
                    }
                  }
                }
              }
            },
            "cleanup": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}