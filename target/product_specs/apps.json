          "backend": "windows_pywinauto",
          "application": {
            "path": "C:\\Program Files\\HiSec-Endpoint\\core\\EDRClient.exe",
            "entry_path": "C:\\Program Files\\HiSec-Endpoint\\core\\safra\\HisecEndpointAgent.exe"
          },
          "windows": [
            {"role": "entry", "name": "华为智能终端安全系统", "names": ["华为智能终端安全系统", "logo1"], "window_path": "entry", "process_names": ["HisecEndpointAgent.exe"], "title_pattern": "^(华为智能终端安全系统|logo1)$"},
